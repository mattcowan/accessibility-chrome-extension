{
  "manifest_version": 3,
  "name": "Accessibility Modes & Checkers",
  "version": "0.1.0",
  "description": "Emulate accessibility media features and vision deficiencies per-tab; run WCAG checkers; export findings to CSV.",
  "minimum_chrome_version": "120",
  "permissions": ["debugger", "scripting", "activeTab", "storage", "sidePanel", "tabs"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "side_panel": { "default_path": "popup/popup.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background/service-worker.js", "type": "module" }
}
